  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@vercel/ncc": "0.45.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "@types/node": "^24.0.0"
  }
}
