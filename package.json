{
  "name": "delivery-readiness-guard",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic GitHub Action for client and developer handoff readiness.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
